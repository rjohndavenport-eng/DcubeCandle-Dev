[
  {
    "name": "theme_info",
    "theme_name": "DCube Theme",
    "theme_version": "1.0.0",
    "theme_author": "DCube Candle Co.",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Logo & Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Recommended: 600x600px PNG with transparent background"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 100,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 180
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be resized to 32x32px"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social sharing image",
        "info": "Shown when site is shared on social media. Recommended: 1200x630px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent color (Lavender)",
        "default": "#6b45a1"
      },
      {
        "type": "color",
        "id": "color_accent_soft",
        "label": "Accent soft (Lavender pale)",
        "default": "#ede5f6"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Gold accent",
        "default": "#c8973a"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background color",
        "default": "#f8f5f0"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface color (cards)",
        "default": "#fefdfb"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text color",
        "default": "#1e1a20"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text color",
        "default": "#5a5560"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border color",
        "default": "#e4d8f2"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "DCube uses Cormorant Garamond (headings), Inter (body), and Italiana (accent). These are loaded from Google Fonts."
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL",
        "info": "Example: https://instagram.com/dcubecandles"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      },
      {
        "type": "text",
        "id": "social_twitter_handle",
        "label": "Twitter/X handle (without @)"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Contact email",
        "default": "hello@dcubecandles.com"
      }
    ]
  },
  {
    "name": "SEO",
    "settings": [
      {
        "type": "textarea",
        "id": "meta_description_default",
        "label": "Default meta description",
        "default": "Hand-poured luxury candles by DCube Candle Co. — natural soy wax, small batch, crafted with love in Sarasota, FL.",
        "info": "Used for pages without specific descriptions. 120-155 characters recommended."
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Enable cart drawer",
        "default": true,
        "info": "Show slide-out cart instead of cart page"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "default": 75,
        "info": "Dollar amount for free shipping. Set to 0 to disable."
      }
    ]
  }
]
