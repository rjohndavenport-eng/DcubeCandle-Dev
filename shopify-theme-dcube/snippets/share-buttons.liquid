{%- liquid
  assign share_title = title | default: product.title | default: article.title | default: page_title
  assign share_url = canonical_url | default: shop.url
  assign encoded_url = share_url | url_encode
  assign encoded_title = share_title | url_encode
-%}
<div class="share-buttons">
  <span class="share-label">{{ label | default: 'Share' }}</span>
  <a href="https://www.facebook.com/sharer/sharer.php?u={{ encoded_url }}" target="_blank" rel="noopener noreferrer">Facebook</a>
  <a href="https://twitter.com/intent/tweet?url={{ encoded_url }}&text={{ encoded_title }}" target="_blank" rel="noopener noreferrer">X</a>
  <a href="https://pinterest.com/pin/create/button/?url={{ encoded_url }}&description={{ encoded_title }}" target="_blank" rel="noopener noreferrer">Pinterest</a>
  <a href="mailto:?subject={{ encoded_title }}&body={{ encoded_url }}">Email</a>
</div>
