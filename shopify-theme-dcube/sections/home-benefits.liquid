<div class="benefits">
  <div class="benefits__inner">
    {%- for block in section.blocks -%}
      <div class="benefit" {{ block.shopify_attributes }}>
        <div class="benefit__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'burn' -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 6 12 12 15 15"/></svg>
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {%- when 'heart' -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            {%- when 'bee' -%}
              {% render 'icon-bee' %}
            {%- else -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
          {%- endcase -%}
        </div>
        <h4>{{ block.settings.heading }}</h4>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Home benefits",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "burn",   "label": "Burn time (clock)" },
            { "value": "shield", "label": "Shield (clean/vegan)" },
            { "value": "heart",  "label": "Heart (love)" },
            { "value": "bee",    "label": "Bee" }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Made with Love"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Each candle poured in honor of Brianna\u2019s light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "burn",
            "heading": "50-Hour Burn",
            "text": "Long-lasting, clean burn from premium soy wax"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "heading": "100% Vegan",
            "text": "Paraffin-free, phthalate-free, sustainably made"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "heart",
            "heading": "Made with Love",
            "text": "Each candle poured in honor of Brianna\u2019s light"
          }
        }
      ]
    }
  ]
}
{% endschema %}
