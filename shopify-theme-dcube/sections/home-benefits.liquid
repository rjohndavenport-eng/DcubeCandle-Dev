<section class="benefits">
  {% for block in section.blocks %}
    <div class="benefit" {{ block.shopify_attributes }}>
      <div class="benefit-icon">
        {% case block.settings.icon %}
          {% when 'clean' %}
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2L12 8"></path>
              <circle cx="12" cy="14" r="6"></circle>
              <path d="M12 17L12 20"></path>
              <circle cx="12" cy="20.5" r="0.5" fill="currentColor"></circle>
            </svg>
          {% when 'love' %}
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C10.5 2 9 3.5 9 5.5C9 7.5 12 10 12 10C12 10 15 7.5 15 5.5C15 3.5 13.5 2 12 2Z"></path>
              <path d="M12 10C12 10 9 12.5 9 14.5C9 16.5 10.5 18 12 18C13.5 18 15 16.5 15 14.5C15 12.5 12 10 12 10Z"></path>
              <path d="M9 18C9 18 6 20.5 6 22.5"></path>
              <path d="M12 18V22.5"></path>
              <path d="M15 18C15 18 18 20.5 18 22.5"></path>
            </svg>
          {% else %}
            {% render 'icon-bee' %}
        {% endcase %}
      </div>
      <h4>{{ block.settings.heading }}</h4>
      <p>{{ block.settings.text }}</p>
    </div>
  {% endfor %}
</section>

{% schema %}
{
  "name": "Home benefits",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "clean",
              "label": "Clean"
            },
            {
              "value": "bee",
              "label": "Bee"
            },
            {
              "value": "love",
              "label": "Love"
            }
          ],
          "default": "bee"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Handcrafted"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Small batch quality"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "clean",
            "heading": "Clean Ingredients",
            "text": "Natural soy wax"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "bee",
            "heading": "Handcrafted",
            "text": "Small batch quality"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "love",
            "heading": "Made with Love",
            "text": "Family legacy"
          }
        }
      ]
    }
  ]
}
{% endschema %}
