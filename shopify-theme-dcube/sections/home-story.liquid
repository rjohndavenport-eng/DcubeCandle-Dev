<section class="story-strip">
  <div class="story-strip__inner">
    {%- if section.settings.label != blank -%}
      <span class="label">{{ section.settings.label }}</span>
    {%- endif -%}

    <h2>{{ section.settings.heading }}</h2>

    <div class="story-strip__photo">
      {%- if section.settings.story_image != blank -%}
        {{ section.settings.story_image | image_url: width: 600 | image_tag:
           loading: 'lazy',
           width: 240,
           height: 240,
           alt: section.settings.story_image.alt | default: 'Brianna' }}
      {%- else -%}
        <img
          src="{{ '90d902bf-d848-4ba3-984a-76fd7fa5fd04.png' | asset_url }}"
          alt="Brianna holding flowers and smiling"
          width="240"
          height="240"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <p>{{ section.settings.paragraph_1 }}</p>
    <p>{{ section.settings.paragraph_2 }}</p>

    <div class="story-strip__cta">
      <a href="{{ section.settings.button_link | default: '/pages/about' }}" class="btn btn-ghost">
        {{ section.settings.button_label }}
      </a>
    </div>

    <div class="story-signature">
      <p>{{ section.settings.signature_line_one }}<br>{{ section.settings.signature_line_two }}</p>
      <span class="bee-icon-signature bee-mark" aria-hidden="true">
        {% render 'icon-bee' %}
      </span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home story",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Overline label",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Light That Continues to Shine"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "DCube is more than a candle company. It\u2019s a family bonded by love, united in purpose, and inspired by the extraordinary light of our beloved Brianna."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Brianna\u2019s symbol was the bee \u2014 tireless, generous, creating something beautiful wherever she went."
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read Her Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "signature_line_one",
      "label": "Signature line 1",
      "default": "With love,"
    },
    {
      "type": "text",
      "id": "signature_line_two",
      "label": "Signature line 2",
      "default": "The DeCubellis Family"
    }
  ],
  "presets": [
    {
      "name": "Home story"
    }
  ]
}
{% endschema %}
