<section class="story">
  <div class="story-content">
    <figure class="story-photo story-photo--brianna">
      {% if section.settings.story_image != blank %}
        {{ section.settings.story_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.story_image.alt | default: 'Brianna holding flowers and smiling' }}
      {% else %}
        <img src="{{ '90d902bf-d848-4ba3-984a-76fd7fa5fd04.png' | asset_url }}" alt="Brianna holding flowers and smiling" loading="lazy">
      {% endif %}
    </figure>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.paragraph_1 }}</p>
    <p>{{ section.settings.paragraph_2 }}</p>
    <a href="{{ section.settings.button_link | default: '/pages/about' }}" class="btn btn-secondary btn-wax-seal">{{ section.settings.button_label }}</a>
    <div class="story-signature">
      <p>{{ section.settings.signature_line_one }}<br>{{ section.settings.signature_line_two }}</p>
      <span class="bee-icon-signature bee-mark" aria-hidden="true">
        {% render 'icon-bee' %}
      </span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Honoring Brianna's Light"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "DCube began as a way to celebrate the life and spirit of our beloved Brianna—a soul who radiated warmth, joy, and unconditional love."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Each candle we create carries her light forward, crafted with care to bring peace and beauty into your space."
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read Our Full Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "signature_line_one",
      "label": "Signature line 1",
      "default": "With love,"
    },
    {
      "type": "text",
      "id": "signature_line_two",
      "label": "Signature line 2",
      "default": "The DeCubellis Family"
    }
  ],
  "presets": [
    {
      "name": "Home story"
    }
  ]
}
{% endschema %}
