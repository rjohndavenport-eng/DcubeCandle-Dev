<section class="hero">
  <div class="hero__image">
    {%- if section.settings.hero_image != blank -%}
      {{ section.settings.hero_image | image_url: width: 2200 | image_tag:
         class: 'hero__image-media',
         loading: 'eager',
         width: 1100,
         height: 680,
         alt: section.settings.hero_image.alt | default: 'DCube candles burning in a warm setting',
         widths: '600,900,1200,1600,2200' }}
    {%- else -%}
      <img
        class="hero__image-media"
        src="{{ 'Untitled_design_17_2000x.webp' | asset_url }}"
        alt="DCube candles styled in a warm lifestyle setting"
        width="1100"
        height="680"
        loading="eager"
      >
    {%- endif -%}
  </div>

  <div class="hero__content">
    {%- if section.settings.label != blank -%}
      <span class="label hero__label">{{ section.settings.label }}</span>
    {%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="hero__cta">
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-primary">
        {{ section.settings.button_label }}
      </a>
      {%- if section.settings.secondary_button_label != blank -%}
        <a href="{{ section.settings.secondary_button_link | default: '/pages/about' }}" class="btn btn-ghost">
          {{ section.settings.secondary_button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Overline label",
      "default": "Purveyor of Luxury Scents",
      "info": "Small uppercase text displayed above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Light That Carries Love"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body",
      "default": "Hand-poured soy candles from Sarasota, FL — crafted in memory of Brianna, to bring warmth into your home."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Home hero"
    }
  ]
}
{% endschema %}
