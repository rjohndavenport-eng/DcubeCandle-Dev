<section class="scent-families">
  <div class="scent-families__inner">

    <div class="section-header">
      {%- if section.settings.label != blank -%}
        <span class="label">{{ section.settings.label }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="families-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="family-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1400 | image_tag:
                 loading: 'lazy',
                 width: 700,
                 height: 420,
                 alt: block.settings.image.alt | default: block.settings.title,
                 widths: '400,600,800,1000,1400' }}
            {%- else -%}
              <div class="family-card__placeholder" aria-hidden="true"></div>
            {%- endif -%}
            <div class="family-overlay">
              <div class="family-title">{{ block.settings.title }}</div>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="family-link">
                  {{ block.settings.link_label | default: 'Explore' }} &rarr;
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_families = 'Floral,Warm & Spiced,Fresh & Clean' | split: ',' -%}
        {%- for name in fallback_families -%}
          <div class="family-card family-card--placeholder">
            <div class="family-card__placeholder" aria-hidden="true"></div>
            <div class="family-overlay">
              <div class="family-title">{{ name }}</div>
              <span class="family-link">Explore &rarr;</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Scent families",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Overline label",
      "default": "Browse by Mood"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Scent"
    }
  ],
  "blocks": [
    {
      "type": "family",
      "name": "Scent family",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Family name",
          "default": "Floral"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scent families",
      "blocks": [
        {
          "type": "family",
          "settings": {
            "title": "Floral",
            "link_label": "Explore"
          }
        },
        {
          "type": "family",
          "settings": {
            "title": "Warm & Spiced",
            "link_label": "Explore"
          }
        },
        {
          "type": "family",
          "settings": {
            "title": "Fresh & Clean",
            "link_label": "Explore"
          }
        }
      ]
    }
  ]
}
{% endschema %}
