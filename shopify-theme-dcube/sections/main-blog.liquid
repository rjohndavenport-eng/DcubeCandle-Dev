<section class="blog-index">
  <div class="blog-index__inner">
    <h1>{{ blog.title }}</h1>
    {% if blog.articles_count > 0 %}
      {% paginate blog.articles by section.settings.articles_per_page %}
        <div class="blog-grid">
          {% for article in blog.articles %}
            <article class="article-card card">
              {% if article.image %}
                {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: article.image.alt | default: article.title }}
              {% endif %}
              <div class="article-card__body">
                <p>{{ article.published_at | date: '%B %d, %Y' }}</p>
                <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
                <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
                <a href="{{ article.url }}" class="btn btn-secondary">Read article</a>
              </div>
            </article>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="pagination" role="navigation" aria-label="Pagination">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>
            {% endif %}
            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {% else %}
                <span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>
              {% endif %}
            {% endfor %}
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>
            {% endif %}
          </nav>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <p>No articles yet.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main blog",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ]
}
{% endschema %}
