<section class="collections-template">
  <div class="collections-template__inner">
    <h1>{{ section.settings.heading }}</h1>
    <div class="collections-grid">
      {% for collection in collections %}
        <article class="collection-card card">
          {% if collection.featured_image %}
            {{ collection.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: collection.title }}
          {% endif %}
          <div class="collection-card__body">
            <h2><a href="{{ collection.url }}">{{ collection.title }}</a></h2>
            <p>{{ collection.description | strip_html | truncate: 120 }}</p>
            <a href="{{ collection.url }}" class="btn btn-secondary">Shop collection</a>
          </div>
        </article>
      {% else %}
        <p>No collections found.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main list collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Collection"
    }
  ]
}
{% endschema %}
