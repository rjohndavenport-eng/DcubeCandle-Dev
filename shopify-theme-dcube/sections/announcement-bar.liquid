{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" role="region" aria-label="Announcement">
    {%- assign bar_text = section.settings.text | default: 'Free shipping on orders $75+' -%}
    {%- assign secondary = section.settings.secondary_text -%}
    {%- assign bar_link = section.settings.link -%}
    {%- assign link_label = section.settings.link_label | default: 'Shop Now →' -%}

    {%- if secondary != blank -%}
      <span>{{ bar_text }}</span>
      <span class="announcement-bar__sep" aria-hidden="true">&nbsp;·&nbsp;</span>
      <span>{{ secondary }}</span>
      {%- if bar_link != blank -%}
        <span class="announcement-bar__sep" aria-hidden="true">&nbsp;·&nbsp;</span>
        <a href="{{ bar_link }}">{{ link_label }}</a>
      {%- endif -%}
    {%- elsif bar_link != blank -%}
      {{ bar_text }}
      <a href="{{ bar_link }}">{{ link_label }}</a>
    {%- else -%}
      {{ bar_text }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Free shipping on orders $75+"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary text (optional)",
      "default": "Hand poured in Sarasota, FL",
      "info": "Appears after a · separator"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link URL (optional)"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop the Collection →"
    }
  ]
}
{% endschema %}
