<section class="cta-block-section" style="padding: 100px 40px; background: {{ section.settings.bg_color }}; text-align: center; position: relative; overflow: hidden;">
  <style>
    .cta-block-inner { max-width: 700px; margin: 0 auto; position: relative; z-index: 2; }
    .cta-block-title { font-family: var(--font-serif); font-size: 42px; margin-bottom: 24px; color: {{ section.settings.text_color }}; }
    .cta-block-subtitle { font-size: 18px; margin-bottom: 40px; color: {{ section.settings.text_color }}; opacity: 0.8; }
    .cta-block-btn { display: inline-block; padding: 16px 40px; background: var(--color-accent); color: white; text-decoration: none; font-size: 12px; font-weight: 600; letter-spacing: 2px; border-radius: 40px; box-shadow: var(--umbra-shadow); transition: transform 0.3s ease; }
    .cta-block-btn:hover { transform: translateY(-3px); background: var(--color-gold); }
    .cta-sunbeam-overlay { position: absolute; top: -50%; left: -20%; width: 50%; height: 200%; background: linear-gradient(105deg, transparent, rgba(255,255,255,0.1), transparent); transform: rotate(25deg); pointer-events: none; }
  </style>

  {% if section.settings.show_sunbeam %}
    <div class="cta-sunbeam-overlay"></div>
  {% endif %}

  <div class="cta-block-inner">
    {% render 'bee-divider' %}
    <h2 class="cta-block-title">{{ section.settings.title }}</h2>
    <p class="cta-block-subtitle">{{ section.settings.subtitle }}</p>
    <a href="{{ section.settings.button_link }}" class="cta-block-btn">{{ section.settings.button_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Dcube CTA Block",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Invite the Scent Into Your Home"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Join our collective of architectural enthusiasts and receive first light on limited editions."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE THE COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F3E5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A148C"
    },
    {
      "type": "checkbox",
      "id": "show_sunbeam",
      "label": "Show Atmospheric Sunbeam",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Dcube CTA Block"
    }
  ]
}
{% endschema %}
