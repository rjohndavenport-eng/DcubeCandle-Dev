<header class="site-header" role="banner">
  <div class="site-header__inner">

    <!-- Left: navigation -->
    <div class="site-header__left">
      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="SiteNav-{{ section.id }}"
        aria-label="Open menu"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <nav id="SiteNav-{{ section.id }}" class="site-nav" data-site-nav aria-label="Main navigation">
        {%- assign nav_menu = linklists[section.settings.menu] -%}
        {%- if nav_menu != blank and nav_menu.links.size > 0 -%}
          {%- for link in nav_menu.links -%}
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}">Shop</a>
          <a href="/pages/about">Our Story</a>
          <a href="/pages/contact">Contact</a>
        {%- endif -%}
      </nav>
    </div>

    <!-- Center: logo -->
    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" class="logo-link" aria-label="{{ shop.name }} — Home">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 640 | image_tag:
             class: 'header-logo',
             alt: shop.name,
             widths: '160,240,320,480,640',
             loading: 'eager' }}
        {%- else -%}
          <img
            src="{{ 'dcube_350x.webp' | asset_url }}"
            class="header-logo"
            alt="{{ shop.name }} — {{ settings.tagline | default: 'Purveyor of Luxury Scents' }}"
            width="350"
            height="350"
            loading="eager"
            style="max-width: {{ settings.logo_width | default: 180 }}px; height: auto;"
          >
        {%- endif -%}
      </a>
    </div>

    <!-- Right: actions -->
    <div class="site-header__actions">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" aria-label="Search">
          {% render 'icon-search' %}
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}" style="position:relative;">
        {% render 'icon-cart' %}
        <span class="cart-badge" data-count="{{ cart.item_count }}" aria-hidden="true">{{ cart.item_count }}</span>
      </a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    }
  ]
}
{% endschema %}
