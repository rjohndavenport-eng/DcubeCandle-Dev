<div class="burn-gauge-wrapper" style="display: flex; align-items: center; gap: 30px; margin: 30px 0;">
  <style>
    .burn-gauge-track { width: 4px; height: 120px; background: var(--color-border); position: relative; }
    .burn-gauge-fill { position: absolute; top: 0; left: 0; width: 100%; height: 45%; background: var(--color-accent); }
    .burn-gauge-marker { position: absolute; left: 15px; font-size: 10px; color: var(--color-muted); text-transform: uppercase; white-space: nowrap; letter-spacing: 1px; }
  </style>
  <div class="burn-gauge-track">
    <div class="burn-gauge-fill"></div>
    <div class="burn-gauge-marker" style="top: 0;">First Light</div>
    <div class="burn-gauge-marker" style="top: 45%;">Present Moment</div>
    <div class="burn-gauge-marker" style="bottom: 0;">Ethereal Memory</div>
  </div>
  <div class="burn-gauge-info">
    <span style="font-family: var(--heading-font-family); font-size: 18px; display: block;">45-Hour Narrative</span>
    <p style="font-size: 12px; opacity: 0.7; margin: 5px 0 0 0;">Hand-poured Sarasota Soy</p>
  </div>
</div>
